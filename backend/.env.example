PORT=5000
# PASTE YOUR REAL MONGODB ATLAS CONNECTION STRING HERE. Keep this file private as .env.
MONGO_URI=PASTE_YOUR_MONGODB_CONNECTION_STRING_HERE
# PASTE A LONG RANDOM SECRET HERE (at least 32 characters). Do not share it.
JWT_SECRET=PASTE_A_LONG_RANDOM_SECRET_HERE
# LOCAL FRONTEND URL during development; after Netlify deploy, replace with your real Netlify URL.
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
